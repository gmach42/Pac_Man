# Full config for a complete game (10 levels)
{
    # --- Files ---
    "highscore_filename": "highscores.json",

    # --- Player ---
    "lives": 3,
    # cells per second
    "player_speed": 6.0,

    # --- Scoring ---
    "points_per_pacgum": 10,
    "points_per_super_pacgum": 50,
    "points_per_ghost": 200,

    # --- Ghosts ---
    # cells per second
    "ghost_speed": 5.0,
    # seconds ghosts stay edible
    "frightened_duration": 7,
    # seconds before an eaten ghost comes back
    "ghost_respawn_delay": 5,

    # --- Maze ---
    # used for level 1 only, next levels are random
    "seed": 42,

    # --- width/height in cells, time in seconds) ---
    "width": 15,
    "height": 15,
    "time": 90,
    "levels": 10,

    # --- Defense helper ---
    "cheat_mode": false
}
